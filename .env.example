# PostgreSQL externo em produção; vazio usa PostgreSQL embarcado PGlite APENAS local.
DATABASE_URL=
PGLITE_DATA_DIR=./data/control-tower
AUTH_SECRET=replace-with-at-least-32-random-characters
AUTH_MODE=local
APP_ORIGIN=http://127.0.0.1:3000
# OIDC será habilitado somente após configurar e validar o provedor corporativo.
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=

# Integrações: use estes nomes em secret_env; valores nunca entram no banco de negócio.
MCT_CONNECTOR_JIRA_TOKEN=
MCT_CONNECTOR_ADO_TOKEN=
MCT_CONNECTOR_GITHUB_TOKEN=
MCT_CONNECTOR_GITLAB_TOKEN=
MCT_CONNECTOR_CONFLUENCE_TOKEN=
MCT_CONNECTOR_CATALOGUE_TOKEN=
# Hosts cloud conhecidos são autorizados; acrescente hosts próprios exatos, separados por vírgula.
MCT_CONNECTOR_ALLOWED_HOSTS=
MCT_CONNECTOR_ALLOW_PRIVATE=false
# Webhook usa um secret separado do token de consulta. Configure o nome em webhook_secret_env.
MCT_CONNECTOR_WEBHOOK_SECRET=

# Gateway opcional: contrato mct-grounded-status-v1; host deve constar na allowlist.
# Requer também opt-in na política do programa e consulta explícita do usuário.
MCT_AI_ENDPOINT=
MCT_AI_TOKEN=

# Worker externo exige DATABASE_URL. Não compartilhe um diretório PGlite entre processos.
MCT_WORKER_ID=
MCT_RETENTION_ENABLED=false
MCT_TRANSIENT_RETENTION_DAYS=30
# Chave aleatória de 32 bytes em hexadecimal, fornecida pelo secrets manager.
MCT_BACKUP_KEY_HEX=
# Banco PostgreSQL VAZIO, isolado e diferente do banco operacional, para teste de restore.
RESTORE_DATABASE_URL=
