{
  "name": "modernization-control-tower",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "npm run api:generate && next build --webpack && node scripts/package-standalone.mjs && npm run worker:build",
    "start": "node scripts/start.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "db:migrate": "node --import tsx scripts/migrate.ts",
    "db:seed": "node --import tsx scripts/seed.ts",
    "db:setup": "npm run db:migrate && npm run db:seed",
    "lint": "eslint src tests scripts",
    "format": "prettier --write src tests scripts *.ts",
    "worker:build": "node scripts/build-worker.mjs",
    "worker": "node dist/worker.mjs",
    "ops:retention": "node --import tsx scripts/retention.ts",
    "api:generate": "node --import tsx scripts/generate-schema-manifest.ts && node --import tsx scripts/generate-openapi.ts",
    "ops:benchmark": "node --import tsx scripts/benchmark.ts",
    "ops:backup": "node --import tsx scripts/pg-backup.ts",
    "ops:restore-test": "node --import tsx scripts/pg-restore-test.ts",
    "test:infra": "node scripts/verify-infrastructure.mjs",
    "docker:local": "node scripts/docker-local.mjs",
    "docker:stop": "node scripts/docker-local.mjs stop"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.3.14",
    "@pdf-lib/fontkit": "^1.1.1",
    "@radix-ui/react-dialog": "^1.1.15",
    "@tanstack/react-query": "^5.90.0",
    "@tanstack/react-table": "^8.21.3",
    "@xyflow/react": "^12.9.0",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.4",
    "exceljs": "^4.4.0",
    "jose": "^6.1.0",
    "lucide-react": "^0.545.0",
    "next": "^16.0.0",
    "openid-client": "^6.8.0",
    "papaparse": "^5.5.3",
    "pdf-lib": "^1.17.1",
    "postgres": "^3.4.7",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "recharts": "^3.3.0",
    "tailwind-merge": "^3.3.1",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@playwright/test": "^1.56.0",
    "@tailwindcss/postcss": "^4.1.14",
    "@types/node": "^22.18.0",
    "@types/papaparse": "^5.3.16",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "eslint": "^9.38.0",
    "eslint-config-next": "^16.0.0",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^5.0.4",
    "esbuild": "^0.28.2"
  },
  "overrides": {
    "exceljs": {
      "uuid": "^11.1.1"
    }
  }
}
